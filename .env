# ============================================
# Конфигурация GIBDD Telegram-бота
# Скопируйте этот файл как .env и заполните значения
# ============================================

# --- Сеть ---
# Таймаут запросов к API stat.gibdd.ru (в секундах).
# При больших выборках API может отвечать медленно. Рекомендуется 60-120.
TARGET_API_TIMEOUT=120

# Прокси (если ваш корпоративный сети использует прокси)
# Оставьте пустым, если прокси не нужен
HTTP_PROXY=
HTTPS_PROXY=

# --- Доступ (опционально) ---
# Список Telegram ID пользователей через запятую, которым разрешено пользоваться ботом.
# Оставьте пустым, чтобы разрешить доступ всем.
ALLOWED_USER_IDS=

# --- Хранилище данных ---
# Директория для кэша (регионы, камеры, OSM-полигоны).
# На bothost.ru используйте /data (если доступно), иначе data/
CAMERA_DATA_DIR=data

# --- Логирование ---
# Уровни: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- LLM (нейросеть для анализа, опционально) ---
# API-ключ для ZhipuAI (GLM). Получить: https://open.bigmodel.cn
# Если не задан — кнопка "Анализ с ИИ" будет недоступна
LLM_API_KEY=
LLM_PAID_API_KEY=
LLM_PAID_API_URL=https://api.aitunnel.ru/v1/

# Модель LLM (по умолчанию glm-5v-turbo)
LLM_MODEL=GLM-4.7-Flash
LLM_PAID_MODEL=deepseek-v4-flash

# Включать ли поиск новостей для контекста LLM
ENABLE_NEWS_SEARCH=true

# ============================================
# Mini App + bothost.ru настройки
# ============================================

# Домен, который выдал bothost.ru (вида bot1234.bothost.tech)
# ИЛИ ваш собственный домен, привязанный к bothost.
# ИСПОЛЬЗУЙТЕ РЕАЛЬНЫЙ домен — от него строится webhook URL.
BOTHOST_DOMAIN=

# Порт, который bothost передаёт через $PORT (обычно 8080).
# На bothost не меняйте — значение приходит из окружения.
PORT=3000

# CORS: разрешённые origins для Mini App.
# Добавьте сюда ваш bothost-домен и поддомены Telegram WebView.
CORS_ORIGINS=

# === Сервис ===
APP_HOST=0.0.0.0
APP_PORT=3000
APP_WORKERS=2

# === Tasks ===
# Директория для временного хранения сгенерированных файлов задач
TASKS_DIR=/tmp/gibdd_tasks
# TTL файлов задач в часах
TASKS_TTL_HOURS=24

# === Database (опционально) ===
# Connection string PostgreSQL. Если задан — задачи и аудит-лог
# персистятся в БД (переживают рестарт, видны из всех воркеров).
# Если НЕ задан или БД недоступна — работает in-memory fallback.
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=
# Минимальный/максимальный размер пула соединений
DB_POOL_MIN=1
DB_POOL_MAX=5
# Таймаут подключения (сек)
DB_CONNECT_TIMEOUT=30

