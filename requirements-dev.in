# ====================================
# Dev dependencies (тесты + инструменты)
# ====================================
# Включает все зависимости requirements.in + dev tools.
# Lock генерируется:  pip-compile requirements-dev.in -o requirements-dev.lock
# Установка для разработки:  pip install -r requirements-dev.lock

-r requirements.in

